{
  "name": "repo-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A zero-maintenance engine that syncs your GitHub identity into a high-performance landing page.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve:static": "node scripts/serve-static.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/kit": "^4.6.3",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@shikijs/markdown-it": "^4.5.0",
    "@vueuse/nuxt": "^15.0.0",
    "consola": "^3.4.2",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.6.3",
    "sanitize-html": "^2.18.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.24",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
