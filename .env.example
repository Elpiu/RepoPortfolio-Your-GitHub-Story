# Token GitHub opzionale: alza solo il rate limit REST. Mai prefisso NUXT_PUBLIC_.
# Senza token la build usa GitHub REST pubblico (60 richieste/ora).
NUXT_GITHUB_TOKEN=
GITHUB_TOKEN=

# 1 = nessuna rete: usa lo snapshot in .cache/github o tests/fixtures/github.json
GITHUB_OFFLINE=

# Cartella dati da usare al posto di data/ (es. datasets/me). Vuota = data/.
# Vale per dev, generate e deploy; in alternativa: pnpm run deploy -- --data datasets/me
PORTFOLIO_DATA_DIR=

# Impostate automaticamente da scripts/deploy.mjs; servono a mano solo con nuxt generate diretto.
NUXT_APP_BASE_URL=
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_GITHUB_USERNAME=
