# Token GitHub opzionale: alza solo il rate limit REST. Mai prefisso NUXT_PUBLIC_.
# Senza token la build usa GitHub REST pubblico (60 richieste/ora).
NUXT_GITHUB_TOKEN=
GITHUB_TOKEN=

# 1 = nessuna rete: usa lo snapshot in .cache/github o tests/fixtures/github.json
GITHUB_OFFLINE=

# In pnpm dev uno snapshot < 24 h viene riusato; 1 = forza la sync con GitHub.
GITHUB_REFRESH=

# Cartella dati da usare al posto di data/ (es. datasets/me). Vuota = data/.
# Vale in locale (dev, generate, build:site); per GitHub Pages: variabile di repository.
PORTFOLIO_DATA_DIR=

# Impostate automaticamente da scripts/build-site.mjs; servono a mano solo con nuxt generate diretto.
NUXT_APP_BASE_URL=
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_GITHUB_USERNAME=
