{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "avatarUrl": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "default": false,
          "type": "boolean"
        },
        "availability": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "fullName",
        "role",
        "tagline"
      ]
    },
    "about": {
      "type": "object",
      "properties": {
        "paragraphs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "paragraphs"
      ]
    },
    "skills": {
      "default": {
        "groups": []
      },
      "type": "object",
      "properties": {
        "groups": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "items"
            ]
          }
        }
      }
    },
    "experiences": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "work",
              "education"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "highlights": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "organization",
          "location",
          "start",
          "end",
          "description"
        ]
      }
    },
    "milestones": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "repo",
              "release",
              "milestone"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "type",
          "date",
          "title",
          "description"
        ]
      }
    }
  },
  "required": [
    "locale",
    "meta",
    "about"
  ]
}
