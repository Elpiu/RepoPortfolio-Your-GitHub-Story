{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "github": {
      "default": {},
      "type": "object",
      "properties": {
        "username": {
          "default": "",
          "type": "string"
        },
        "excludedRepos": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "includeForks": {
          "default": false,
          "type": "boolean"
        },
        "includeArchived": {
          "default": false,
          "type": "boolean"
        },
        "excludeProfileRepo": {
          "default": true,
          "type": "boolean"
        },
        "maxRepos": {
          "default": 300,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "readmeMaxBytes": {
          "default": 200000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "phone": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "linkedin": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "cvUrl": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "email"
      ]
    },
    "career": {
      "default": {},
      "type": "object",
      "properties": {
        "start": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "story": {
      "default": {},
      "type": "object",
      "properties": {
        "autoEvents": {
          "default": true,
          "type": "boolean"
        },
        "maxAutoEvents": {
          "default": 8,
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "default": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "language",
          "name"
        ]
      }
    },
    "deploy": {
      "default": {},
      "type": "object",
      "properties": {
        "customDomain": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "seo": {
      "default": {},
      "type": "object",
      "properties": {
        "siteName": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "twitterHandle": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "faviconUrl": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "required": [
    "links",
    "locales"
  ]
}
